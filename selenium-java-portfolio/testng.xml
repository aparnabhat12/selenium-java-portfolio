<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium Automation Portfolio Suite" verbose="1" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="com.qaportfolio.listeners.TestListener"/>
    </listeners>

    <!-- Chrome Tests -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qaportfolio.tests.LoginTest"/>
            <class name="com.qaportfolio.tests.InventoryTest"/>
            <class name="com.qaportfolio.tests.CheckoutTest"/>
        </classes>
    </test>

    <!-- Firefox Tests -->
    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.qaportfolio.tests.LoginTest"/>
            <class name="com.qaportfolio.tests.InventoryTest"/>
        </classes>
    </test>

    <!-- Edge Tests -->
    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.qaportfolio.tests.LoginTest"/>
        </classes>
    </test>

</suite>
