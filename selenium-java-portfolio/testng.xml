<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium Automation Portfolio Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.qaportfolio.listeners.TestListener"/>
    </listeners>

    <!-- Chrome Tests Only -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qaportfolio.tests.LoginTest"/>
            <class name="com.qaportfolio.tests.InventoryTest"/>
            <class name="com.qaportfolio.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>